{
  "name": "tscopier-mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios",
    "ios:pods": "cd ios && pod install",
    "ios:xcode": "open ios/*.xcworkspace",
    "web": "expo start --web",
    "build": "expo export",
    "typecheck": "tsc --noEmit",
    "version:increment": "node scripts/increment-version.js",
    "version:increment:minor": "node scripts/increment-version.js minor",
    "version:increment:major": "node scripts/increment-version.js major",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "postinstall": "patch-package && node ../../packages/web-lib/scripts/link-web-lib-packages.js"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.105.3",
    "@tscopier/shared": "file:../../packages/shared",
    "@tscopier/web-i18n": "file:../../packages/web-i18n",
    "@tscopier/web-lib": "file:../../packages/web-lib",
    "clsx": "^2.1.1",
    "expo": "~57.0.7",
    "expo-auth-session": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.8",
    "expo-web-browser": "~57.0.1",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
